generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(USER)
  teamId    String?

  // relation with the team table
  Team      Team?     @relation(fields: [teamId],references: [id],onDelete: SetNull)

  //timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexing for performance
  @@index([email])
  @@index([role])
  @@index([teamId])

  // /mapping
  @@map("users")

}


model Team {
  id               String      @id @default(cuid())
  name             String      @unique
  description      String?     
  code             String      @unique
  members          User[]

  //timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // /mapping
  @@map("teams")

}


enum Role {
  ADMIN
  MANAGER
  USER
  GUEST
}